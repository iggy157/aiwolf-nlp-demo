# Docker を使わずに動かすときの Caddy 設定。
#
# コンテナ名（lobby:8002 等）ではなく 127.0.0.1 のポートを直接見る。
# 1024番以上で待つので root は要らない。
{
	admin off
	auto_https off
}

{$DEMO_SITE_ADDRESS::8088} {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:{$LOBBY_PORT:8002}
	}

	# 待合室ゲートの操作口（/control/*）はロビー専用。鍵があっても外からは触らせない。
	handle /gs/control/* {
		respond 403
	}
	handle /gs9/control/* {
		respond 403
	}

	# 観戦用。ゲームサーバが書き出す実況ファイル（/realtime/*.jsonl）を外へ。
	# ビューアの /realtime ページに ?url=<ここ>/gs を渡して読ませる。
	handle_path /gs/* {
		reverse_proxy 127.0.0.1:{$GAME_PORT:8080}
	}
	handle_path /gs9/* {
		reverse_proxy 127.0.0.1:{$GAME_PORT_9:8081}
	}

	handle /ws9 {
		rewrite * /ws
		reverse_proxy 127.0.0.1:{$GAME_PORT_9:8081}
	}

	handle /ws {
		reverse_proxy 127.0.0.1:{$GAME_PORT:8080}
	}

	handle {
		root * {$VIEWER_ROOT}
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}
