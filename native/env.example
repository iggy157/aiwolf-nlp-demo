# native/env — Docker を使わずに動かすときの設定。scripts/open.sh が読む。
# cp native/env.example native/env して使う（native/env は .gitignore 済み）。

# ---- 公開 ----
PUBLIC_BASE=http://133.167.32.100:8013
LOCAL_PORT=8088                       # このマシンで Caddy が待つポート
# TUNNEL=quick にすると cloudflared のクイックトンネル（https・無料・アカウント不要）で公開する。
# URLは起動のたびに変わるが暗号化されるので、参加者の持ち込みAPIキーはこのモードでだけ受け付ける。
# 空欄なら従来どおり SSH 中継（上の PUBLIC_BASE・平文http）。
TUNNEL=

# ---- LLM（サーバ既定）----
# vLLM を使うなら vllm、運営のAPIキーで回すなら openai/google。
# 未設定でも動く（その場合、遊ぶ人が自分のキーを入れれば遊べる）。
LLM_PROVIDER=vllm
LLM_MODEL=google/gemma-3-12b-it
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=dummy

# vLLM を open.sh から一緒に起動するなら 1。GPU を使わない日は 0。
START_VLLM=1
VLLM_MODEL=google/gemma-3-12b-it
VLLM_PORT=8000
VLLM_GPUS=0                            # CUDA_VISIBLE_DEVICES に渡す
VLLM_EXTRA="--max-model-len 8192"

# ---- 卓 ----
AI_COUNT=4
MAX_CONCURRENT_GAMES=4
DEFAULT_LANGUAGE=ja

# ---- 待合室ゲート ----
# ゲームサーバの /control/* をロビーだけが叩けるようにする共有鍵（両方が同じ値を読む）。
# 空だとゲート無し＝人数が揃った瞬間に卓が立つ。
CONTROL_KEY=change-me-to-a-random-string
# 待合室のまま誰も準備完了/開始を押さないときに卓を片付けるまでの秒数
GATE_WAIT_TTL=600

# ---- 試合ログの公開 ----
# 終わった試合の game/*.log(CSV) と json/*.json を1回だけ scp で送る。空なら公開しない。
LOG_PUBLISH_DEST=aiwolf:/var/www/html/aiwolf/2026/demo
LOG_PUBLIC_URL=https://133.167.32.100/aiwolf/2026/demo/log/
LOG_PUBLISH_INTERVAL=60
